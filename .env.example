# Copy to .env.local and fill in what you have. Every value is optional:
# anything missing runs in mock mode, so the app works with zero keys.

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# AI agent
ANTHROPIC_API_KEY=

# Product search
CHANNEL3_API_KEY=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/keepalive, called daily by a Render Cron Job
CRON_SECRET=

# Demo: make every capture fail with INSTRUMENT_DECLINED
DEMO_FORCE_DECLINE=false
